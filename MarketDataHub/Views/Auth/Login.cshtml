@{
    ViewBag.Title = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>MarketDataHub - Login</title>
    <link rel="stylesheet" href="/Content/Site.css" />
</head>
<body class="login-page">
    <div class="login-container">
        <div class="login-logo">
            <h1>📈 MarketDataHub</h1>
            <p class="login-subtitle">LSEG Market Data Distribution System</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-error">@ViewBag.Error</div>
        }

        <form method="post" action="/Auth/Login">
            <div class="form-group">
                <label for="username">Username (LSEG Domain)</label>
                <input type="text" id="username" name="username" placeholder="e.g., stuart.m" required autofocus />
            </div>
            <div class="form-group">
                <label for="password">Password</label>
                <input type="password" id="password" name="password" required />
            </div>
            <div class="form-group">
                <label><input type="checkbox" name="rememberMe" /> Remember me</label>
            </div>
            <button type="submit" class="btn btn-primary btn-block">Sign In</button>
        </form>

        <div class="login-footer">
            <p>Having trouble? Contact <a href="mailto:it-helpdesk@lseg-internal.local">IT Helpdesk</a></p>
            <p class="login-small">MarketDataHub v4.1.3 | Internal Use Only</p>
        </div>
    </div>
</body>
</html>
