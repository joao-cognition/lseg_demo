<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - MarketDataHub</title>
    <link rel="stylesheet" href="~/Content/Site.css" />
    <script src="~/Scripts/market-data.js"></script>
</head>
<body>
    <div class="header">
        <div class="header-left">
            <h1 class="logo">📈 MarketDataHub</h1>
            <span class="version">v4.1.3</span>
        </div>
        <nav class="main-nav">
            <a href="/Dashboard">Dashboard</a>
            <a href="/Instruments">Instruments</a>
            <a href="/Reports">Reports</a>
            <a href="/Instruments/Suspended">Suspended</a>
        </nav>
        <div class="header-right">
            @if (Session["Username"] != null)
            {
                <span class="user-info">@Session["FullName"] (@Session["Role"])</span>
                <a href="/Auth/Logout" class="btn-logout">Logout</a>
            }
        </div>
    </div>

    <div class="container">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">@TempData["SuccessMessage"]</div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-error">@TempData["ErrorMessage"]</div>
        }

        @RenderBody()
    </div>

    <div class="footer">
        <p>&copy; @DateTime.Now.Year Market Data Services | MarketDataHub v4.1.3 | Instance: PROD-LDN-MDH-01</p>
        <p class="footer-small">Internal use only. Market data is delayed by up to 15 seconds. For official data, use the Refinitiv terminal.</p>
    </div>
</body>
</html>
