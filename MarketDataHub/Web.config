<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- Application Settings -->
    <add key="AppName" value="MarketDataHub - Real-Time Market Data Distribution" />
    <add key="AppVersion" value="4.1.3" />
    <add key="Environment" value="Production" />
    <add key="InstanceId" value="PROD-LDN-MDH-01" />

    <!-- Market Data Feed - On-Premises FIX Gateway -->
    <add key="FixGatewayHost" value="fix-gw01.corp-internal.local" />
    <add key="FixGatewayPort" value="9876" />
    <add key="FixSenderCompId" value="MDHUB_PROD" />
    <add key="FixTargetCompId" value="MKT_FEED" />
    <add key="FixPassword" value="F1xPr0d!2019Ldn" />
    <add key="FixHeartbeatIntervalSec" value="30" />

    <!-- Secondary Feed - Reuters/Refinitiv (legacy connection) -->
    <add key="RefinitivFeedHost" value="refeed01.corp-internal.local" />
    <add key="RefinitivFeedPort" value="14002" />
    <add key="RefinitivApiKey" value="rik_live_9a8b7c6d5e4f3a2b1c0d9e8f7a6b5c4d" />

    <!-- SMTP Configuration - On-Premises Exchange Server -->
    <add key="SmtpServer" value="mail.corp-internal.local" />
    <add key="SmtpPort" value="25" />
    <add key="SmtpUsername" value="mdh-svc@corp-internal.local" />
    <add key="SmtpPassword" value="MdHub!Sm7p2019" />
    <add key="SmtpFromAddress" value="noreply-mdh@corp-internal.local" />

    <!-- File Storage - On-Premises Network Share -->
    <add key="TickDataArchivePath" value="\\MDH-NAS01\MarketData\TickArchive" />
    <add key="EndOfDayPath" value="\\MDH-NAS01\MarketData\EOD" />
    <add key="ReportOutputPath" value="\\MDH-NAS01\MarketData\Reports" />
    <add key="TempFilePath" value="\\MDH-NAS01\MarketData\Temp" />

    <!-- Tick Data Retention -->
    <add key="TickRetentionDays" value="730" />
    <add key="EodRetentionYears" value="7" />

    <!-- Logging - writes to on-prem file share -->
    <add key="LogFilePath" value="\\MDH-NAS01\MarketData\Logs\mdh.log" />
    <add key="LogLevel" value="DEBUG" />

    <!-- Proprietary TCP Distribution (legacy protocol for downstream consumers) -->
    <add key="TcpDistributionPort" value="18500" />
    <add key="TcpMaxClients" value="250" />
    <add key="TcpBufferSizeKB" value="64" />

    <!-- Legacy LDAP Authentication -->
    <add key="LdapServer" value="ldap://dc01.corp-internal.local:389" />
    <add key="LdapBaseDn" value="DC=corp-internal,DC=local" />
    <add key="LdapServiceAccount" value="CN=svc-mdh,OU=ServiceAccounts,DC=corp-internal,DC=local" />
    <add key="LdapServicePassword" value="LdapM@rket2018!" />

    <!-- Session Configuration -->
    <add key="SessionTimeoutMinutes" value="480" />

    <!-- FCA Regulatory Reporting -->
    <add key="FcaReportingEndpoint" value="http://reg-report.corp-internal.local:7070/api/submit" />
    <add key="FcaEntityId" value="LEI-549300FMGSLFKJG84H52" />
    <add key="MifidReportPath" value="\\MDH-NAS01\MarketData\Regulatory\MiFID" />

    <!-- Index Calculation -->
    <add key="FtseCalcEngineUrl" value="http://idx-calc01.corp-internal.local:6060/api" />
    <add key="IndexRecalcIntervalSec" value="15" />

    <!-- Bloomberg Terminal Integration (backup feed) -->
    <add key="BloombergApiHost" value="bbg-api.corp-internal.local" />
    <add key="BloombergApiPort" value="8194" />
    <add key="BloombergApiKey" value="bb_dk_29f8a3b1c4e5d6a7b8c9" />
  </appSettings>

  <connectionStrings>
    <!-- Primary Database - On-Premises SQL Server -->
    <add name="MarketDataDb"
         connectionString="Server=MDH-SQL01\MSSQLSERVER;Database=MarketDataHub;User Id=mdh_app;Password=Sql_Mkt!D4ta2017;Connection Timeout=30;Max Pool Size=200;"
         providerName="System.Data.SqlClient" />

    <!-- Tick Data Store - Dedicated SQL Instance (high I/O) -->
    <add name="TickDataDb"
         connectionString="Server=MDH-SQL03\TICKDATA;Database=TickStore;User Id=tick_writer;Password=T1ckWr!te2018;Connection Timeout=15;Max Pool Size=500;"
         providerName="System.Data.SqlClient" />

    <!-- Reporting Database - Read Replica -->
    <add name="ReportingDb"
         connectionString="Server=MDH-SQL02\MSSQLSERVER;Database=MarketDataHub;User Id=mdh_readonly;Password=SqlR3p0rt!2017;Connection Timeout=30;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <system.web>
    <compilation debug="true" targetFramework="4.6.1" />
    <httpRuntime targetFramework="4.6.1" maxRequestLength="51200" executionTimeout="300" />
    <customErrors mode="Off" />
    <authentication mode="Forms">
      <forms loginUrl="~/Auth/Login" timeout="480" />
    </authentication>
    <sessionState mode="InProc" timeout="480" />
    <pages>
      <namespaces>
        <add namespace="System.Web.Mvc" />
        <add namespace="System.Web.Routing" />
      </namespaces>
    </pages>
  </system.web>

  <system.webServer>
    <modules runAllManagedModulesForAllRequests="true" />
    <handlers>
      <remove name="ExtensionlessUrlHandler-Integrated-4.0" />
      <add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="*"
           type="System.Web.Handlers.TransferRequestHandler"
           preCondition="integratedMode,runtimeVersionv4.0" />
    </handlers>
    <httpProtocol>
      <customHeaders>
        <add name="Access-Control-Allow-Origin" value="*" />
        <add name="Access-Control-Allow-Methods" value="GET, POST, PUT, DELETE, OPTIONS" />
        <add name="Access-Control-Allow-Headers" value="*" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>

  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-12.0.0.0" newVersion="12.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Mvc" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="0.0.0.0-5.2.7.0" newVersion="5.2.7.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
